{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "strict": true,
    "types": ["$app/types", "@types/umami-browser", "node"],
    "paths": {
      "$params": ["./src/params"],
      "$types": ["./src/lib/types"],
      "$db": ["./src/db"],
      "$constants": ["./src/lib/server/constants"],
      "$ctx": ["./src/context"],
      "$routes": ["./src/routes"],
      "$src": ["./src"],
      "$ui": ["./src/lib/components/ui"],
      "$utils": ["./src/lib/shared/utils.ts"],
      "$hooks": ["./src/lib/hooks"],
      "$components": ["./src/lib/components"],
      "$params/*": ["./src/params/*"],
      "$types/*": ["./src/lib/types/*"],
      "$db/*": ["./src/db/*"],
      "$constants/*": ["./src/lib/server/constants/*"],
      "$ctx/*": ["./src/context/*"],
      "$routes/*": ["./src/routes/*"],
      "$src/*": ["./src/*"],
      "$ui/*": ["./src/lib/components/ui/*"],
      "$utils/*": ["./src/lib/shared/*"],
      "$utils.js": ["./src/lib/shared/utils.ts"],
      "$hooks/*": ["./src/lib/hooks/*"],
      "$components/*": ["./src/lib/components/*"]
    }
  },
  "include": [
    ".svelte-kit/ambient.d.ts",
    "src",
    "vite.config.ts",
    "drizzle.config.ts",
    "playwright.config.ts",
    "eslint.config.ts"
  ],
  "exclude": ["src/service-worker"]
}
