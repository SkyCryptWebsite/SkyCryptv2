{
  "name": "skycrypt-frontend",
  "version": "4.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/SkyCryptWebsite/SkyCrypt-Frontend.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "dotenv -e .env.development -- vite build",
    "preview": "vite preview",
    "preview:dev": "dotenv -e .env.development -- vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "runbuild": "node ./build",
    "test": "vitest --run",
    "test:unit": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --run --coverage",
    "lint": "oxfmt --check . && eslint . && pnpm check",
    "format": "oxfmt",
    "prepare": "svelte-kit sync || echo ''",
    "postinstall": "simple-git-hooks",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:tag": "changeset tag",
    "release:beta": "node scripts/release-beta.mjs",
    "release:stable": "node scripts/release-stable.mjs",
    "test:e2e": "playwright test",
    "db:start": "docker compose up",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/schema/auth.schema.ts --yes && oxfmt --write src/lib/server/db/schema/auth.schema.ts",
    "update:shadcn": "pnpm dlx shadcn-svelte@latest update -a && oxfmt --write ./src/lib/components/ui && oxfmt --write ./src/lib/shared/utils.ts"
  },
  "dependencies": {
    "@payloadcms/richtext-lexical": "^3.89.0",
    "@sentry/sveltekit": "^10.74.0",
    "@takumi-rs/core-linux-x64-gnu": "^2.13.7",
    "culori": "^4.0.2",
    "simple-git-hooks": "^2.14.0",
    "takumi-js": "^2.13.7"
  },
  "devDependencies": {
    "@better-auth/api-key": "^1.7.7",
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/svelte": "^0.5.0",
    "@emoji-mart/data": "^1.2.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/unifontex": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.54.0",
    "@oslojs/encoding": "^1.1.0",
    "@playwright/test": "^1.63.0",
    "@selemondev/svgl-svelte": "^2.17.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/load-config": "^0.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.5.1",
    "@types/relaxed-json": "^1.0.4",
    "@types/umami-browser": "^2.18.1",
    "@types/upng-js": "^2.1.5",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "auth": "^1.7.7",
    "better-auth": "^1.7.7",
    "bits-ui": "^2.19.2",
    "changesets-changelog-clean": "^1.4.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "devalue": "^5.9.2",
    "discord-api-types": "^0.38.55",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "formsnap": "^2.0.1",
    "globals": "^17.12.0",
    "ky": "^2.1.0",
    "mode-watcher": "^1.1.0",
    "numerable": "^0.3.15",
    "orval": "^8.31.0",
    "oxfmt": "^0.67.0",
    "paneforge": "^1.0.2",
    "playwright": "^1.63.0",
    "postgres": "^3.4.9",
    "pretty-ms": "^9.3.1",
    "runed": "^0.37.1",
    "shadcn-svelte": "^1.6.1",
    "skinview3d": "^3.4.2",
    "super-sitemap": "^2.0.6",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-persisted-store": "^0.12.0",
    "svelte-seo": "^2.0.0",
    "svelte-sonner": "^1.2.1",
    "svelte-tiny-virtual-list": "4.0.0",
    "svelte-toolbelt": "^0.10.6",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-motion": "^1.1.1",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vitest-browser-svelte": "^3.1.0",
    "zod": "^4.6.2"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "engines": {
    "bun": "forbidden, use pnpm instead",
    "deno": "forbidden, use node instead",
    "node": "^24",
    "npm": "forbidden, use pnpm instead",
    "pnpm": "^12",
    "yarn": "forbidden, use pnpm instead"
  }
}
